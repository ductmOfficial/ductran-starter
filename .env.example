# Local development only. Copy to `.env` and adjust if needed: cp .env.example .env
# These credentials are for the PostgreSQL container on your machine; never reuse them in production.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Connection string for apps (used from phase 2a). Keep it in sync with the values above.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
